FROM ghcr.io/cyber-dojo-languages/clojure:c0ce7a7
LABEL maintainer=frederic.merizen@soft-xki.com
LABEL maintainer=jon@jaggersoft.com

ENV MIDJE_COLORIZE=false
ENV NO_COLOR=1

COPY write_project_clj.sh /tmp
RUN bash /tmp/write_project_clj.sh \
 && rm /tmp/write_project_clj.sh

COPY record_midje_version.sh /tmp
RUN cd /tmp \
 && lein deps \
 && bash /tmp/record_midje_version.sh \
 && rm /tmp/record_midje_version.sh \
 && chown -R sandbox:sandbox /.m2

# A kata's test run reads the three files this leaves behind. It loads midje
# from class files compiled here instead of compiling midje's source again,
# replays an archive of the classes that loading them needs, and takes the
# classpath as given instead of starting lein to ask for it. The script explains
# why compiling midje is what makes the archive worth anything.
COPY run_fact_files.clj /
COPY bake_aot_classpath_and_cds_archive.sh /tmp
RUN bash /tmp/bake_aot_classpath_and_cds_archive.sh \
 && rm -rf /tmp/bake_aot_classpath_and_cds_archive.sh /tmp/project.clj /tmp/aot
